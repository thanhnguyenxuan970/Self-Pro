/** YYYY-MM-DD for Monday of the week containing `date` */
export function getWeekStartFor(date: Date): string {
  const d = new Date(date);
  const dow = d.getDay();
  const diff = dow === 0 ? 6 : dow - 1;
  d.setDate(d.getDate() - diff);
  return toYMD(d);
}
```

