// v5 -> v6: performance indexes on hot tables
async function v6(db: SQLiteDatabase): Promise<void> {
  await db.execAsync(`
    CREATE INDEX IF NOT EXISTS idx_activity_user_date ON activity_log(user_id, local_date);
