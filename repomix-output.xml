      justifyContent: 'space-between',
      marginBottom: 16,
    },
    navBtn: { padding: 12 },
    monthLabel: { fontSize: 16, fontFamily: FontFamily.bold, color: colors.inkDark },
    dowRow: {
      flexDirection: 'row',
      marginBottom: 4,
      paddingHorizontal: 1,
    },
    dowLabel: {
      flex: 1,
      textAlign: 'center',
      fontSize: 12,
      fontFamily: FontFamily.bold,
      color: colors.ink2,
      paddingVertical: 4,
    },
    grid: {
      flexDirection: 'row',
