    if (p === '/manual-edit-discard' && req.method === 'POST') {
      const token = url.searchParams.get('token');
      if (token !== getToken()) { res.writeHead(401); res.end('Unauthorized'); return true; }
      const pageUrl = url.searchParams.get('pageUrl');
