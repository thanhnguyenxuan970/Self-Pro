<title>Habi · Điểm danh bù đa-ngày (ý tưởng #4)</title>
<style>
  :root{
    --primary:#25B36E; --primaryHover:#1E9B5E; --primaryPress:#177A49; --primarySoft:#C6E9D5;
    --tintBg:#EAF7F0; --bgBase:#F5F6F5; --surface:#FFFFFF; --line:#ECEEEC;
    --ink:#1B1F1D; --ink2:#3F4642; --muted:#6E7672; --faint:#A5ABA7;
    --gold:#E0A93B; --orange:#E57D00; --danger:#D74045; --dangerSoft:#FBE2E3; --warnBg:#FBEFD3; --warnInk:#8A6110;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0; height:100%;}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif; background:#E7E9E8; color:var(--ink); display:flex; flex-direction:column; align-items:center; gap:14px; padding:22px 12px 40px; min-height:100%;}
