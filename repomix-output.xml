    {k:'eng', ic:'🗣️', nm:'Học tiếng Anh'}
  ];
  var DURS = [{lbl:'30′', m:30},{lbl:'1h', m:60},{lbl:'1.5h', m:90}];
  var S = {};

  function loadScenario(sc){
    document.getElementById('scA').className='cbtn'+(sc==='A'?' act':' k');
    document.getElementById('scB').className='cbtn'+(sc==='B'?' act':'');
    document.getElementById('scC').className='cbtn'+(sc==='C'?' act':'');
    var missed;
    if(sc==='A') missed=[{id:'d4',label:'Thứ Tư, 14/7'},{id:'d5',label:'Thứ Năm, 15/7'},{id:'d6',label:'Thứ Sáu, 16/7'}];
    else if(sc==='B') missed=[{id:'d5',label:'Thứ Năm, 15/7'},{id:'d6',label:'Thứ Sáu, 16/7'}];
    else missed=[];
    S={scenario:sc, quota:2, missed:missed.map(function(d){return {id:d.id,label:d.label,done:false};}), curDay:null, sel:null, mins:30, editId:null, entriesByDay:{}};
    S.missed.forEach(function(d){S.entriesByDay[d.id]=[];});
    closeSheets();
    renderHome();
  }

  function remainingQuota(){ var used=S.missed.filter(function(d){return d.done;}).length; return Math.max(0,S.quota-used); }
  function pendingCount(){ return S.missed.filter(function(d){return !d.done;}).length; }
  function bufferable(){ return Math.min(remainingQuota(), pendingCount()); }

  function renderHome(){
    var chip=document.getElementById('chip');
    var pend=pendingCount(), rem=remainingQuota(), done=S.missed.filter(function(d){return d.done;}).length;
    var dot=document.getElementById('tabDot');

    if(S.missed.length===0){ chip.classList.add('hide'); dot.classList.remove('on'); document.getElementById('streak').textContent='13'; return; }
    chip.classList.remove('hide');
    dot.textContent=Math.min(remainingQuota(),pendingCount()); dot.classList.add('on');

    if(pend===0){
      chip.classList.add('done');
      chip.querySelector('.newtag').style.display='none';
      chip.querySelector('.ic').textContent='✓';
      document.getElementById('chipBtn').style.display='none';
      var allSaved = done>=S.missed.length;
      document.getElementById('chipT1').textContent='Đã bù '+done+' ngày';
      document.getElementById('chipT2').textContent = allSaved ? 'Chuỗi được nối lại — tiếp tục nhé' : 'Đã dùng hết lượt · vẫn còn ngày lỡ chưa cứu';
      document.getElementById('streak').textContent = allSaved ? String(12+1) : '1';
      return;
    }

    chip.classList.remove('done');
    chip.querySelector('.newtag').style.display='';
    chip.querySelector('.ic').textContent='↩';
    document.getElementById('chipBtn').style.display='';
    document.getElementById('streak').textContent='1';
    var t1 = pend===1 ? ('Bạn lỡ 1 ngày tuần này') : ('Tuần này bạn lỡ '+pend+' ngày');
    document.getElementById('chipT1').textContent=t1;
    var canFix = Math.min(rem,pend);
    var t2;
    if(pend<=rem) t2='Bù cả '+pend+' ngày để nối lại chuỗi · còn '+rem+' lượt';
    else t2='Chỉ bù được '+canFix+'/'+pend+' ngày (giới hạn '+rem+' lượt/tuần) — chuỗi khó cứu trọn';
    document.getElementById('chipT2').textContent=t2;
  }

  function openDayPicker(){
    renderDayPicker();
    document.getElementById('scrim').classList.add('on');
    document.getElementById('dayPicker').classList.add('on');
  }
  function renderDayPicker(){
    var rem=remainingQuota(), pend=pendingCount();
    document.getElementById('dpSub').textContent='Tuần này · '+pend+' ngày chưa bù';
    var q=document.getElementById('dpQuota'); q.textContent='Còn '+rem+' lượt/tuần'; q.className='qbadge'+(rem<=0?' warn':'');
    var note=document.getElementById('dpNote');
    if(pend<=rem && pend>0){ note.className='streaknote good'; note.innerHTML='<span>🔗</span><span>Bù hết '+pend+' ngày này sẽ <b>nối lại chuỗi</b> của bạn.</span>'; }
    else if(rem>0){ note.className='streaknote bad'; note.innerHTML='<span>⚠️</span><span>Bạn lỡ '+pend+' ngày nhưng chỉ còn '+rem+' lượt. Còn ngày trống thì <b>chuỗi vẫn đứt</b> — bù chủ yếu để ghi lại hoạt động, không tua lại được.</span>'; }
    else { note.className='streaknote bad'; note.innerHTML='<span>⚠️</span><span>Hết lượt bù tuần này. Tuần sau reset — hoặc bắt đầu lại cho nhẹ đầu.</span>'; }

    var html='';
    S.missed.forEach(function(d){
      if(d.done){ html+='<div class="dayrow done"><div style="flex:1"><div class="dnm">'+d.label+'</div><div class="dmeta">'+S.entriesByDay[d.id].length+' hoạt động · đã khoá</div></div><span class="tick">✓</span></div>'; }
      else if(rem<=0){ html+='<div class="dayrow locked"><div style="flex:1"><div class="dnm">'+d.label+'</div><div class="dmeta">Hết lượt bù</div></div></div>'; }
      else { html+='<div class="dayrow" onclick="openBuilder(\''+d.id+'\')"><div style="flex:1"><div class="dnm">'+d.label+'</div><div class="dmeta">Chưa có hoạt động</div></div><span class="arr">›</span></div>'; }
    });
    document.getElementById('dayList').innerHTML=html;
  }

  function openBuilder(dayId){
    S.curDay=dayId; S.sel=null; S.mins=30; S.editId=null;
    document.getElementById('dayPicker').classList.remove('on');
    var d=S.missed.find(function(x){return x.id===dayId;});
    document.getElementById('bDate').textContent='Cho ngày '+d.label;
    var q=document.getElementById('bQuota'); q.textContent='Còn '+remainingQuota()+' lượt/tuần'; q.className='qbadge';
    document.getElementById('durInput').value='30';
    renderBuilder();
    document.getElementById('scrim').classList.add('on');
    document.getElementById('builder').classList.add('on');
  }

  function renderBuilder(){
    var opt=''; LIB.forEach(function(a){
      var on=S.sel===a.k;
      opt+='<div class="opt'+(on?' sel':'')+'" onclick="selOpt(\''+a.k+'\')"><span class="oic">'+a.ic+'</span><span class="onm">'+a.nm+'</span>'+(on?'<span class="tk">✓</span>':'')+'</div>';
    });
    document.getElementById('optList').innerHTML=opt;

    var dr=''; DURS.forEach(function(x){ dr+='<div class="dur'+(S.mins===x.m?' on':'')+'" onclick="selDur('+x.m+')">'+x.lbl+'</div>'; });
    document.getElementById('durRow').innerHTML=dr;

    var ents=S.entriesByDay[S.curDay];
    var ew=document.getElementById('entriesWrap');
    if(ents.length>0){
      ew.style.display='';
      var eh=''; ents.forEach(function(e){
        eh+='<div class="entry"><span class="eic">'+e.ic+'</span><div class="ecol"><div class="enm">'+e.nm+'</div><div class="emeta">'+e.mins+' phút</div></div><span class="eact" onclick="editEntry(\''+e.id+'\')">✎</span><span class="eact del" onclick="delEntry(\''+e.id+'\')">✕</span></div>';
      });
      document.getElementById('entryList').innerHTML=eh;
    } else ew.style.display='none';

    document.getElementById('addBtn').disabled = !S.sel;
    document.getElementById('addBtn').textContent = S.editId ? '✓ Cập nhật hoạt động' : '＋ Thêm hoạt động';
    var save=document.getElementById('saveBtn');
    save.disabled = ents.length===0;
    save.textContent = ents.length===0 ? 'Thêm ít nhất 1 hoạt động' : ('Lưu & khoá ('+ents.length+') →');
  }

  function selOpt(k){ S.sel = S.sel===k? null : k; renderBuilder(); }
  function selDur(m){ S.mins=m; document.getElementById('durInput').value=String(m); renderBuilder(); }
  function onDurInput(){ var v=parseInt(document.getElementById('durInput').value,10); if(!isNaN(v)) S.mins=v; renderBuilder(); }

  function addEntry(){
    if(!S.sel) return;
    var a=LIB.find(function(x){return x.k===S.sel;});
    var ents=S.entriesByDay[S.curDay];
    if(S.editId){ var e=ents.find(function(x){return x.id===S.editId;}); e.k=a.k; e.ic=a.ic; e.nm=a.nm; e.mins=S.mins; S.editId=null; }
    else ents.push({id:'e'+Math.random().toString(36).slice(2,7), k:a.k, ic:a.ic, nm:a.nm, mins:S.mins});
    S.sel=null; S.mins=30; document.getElementById('durInput').value='30';
    renderBuilder();
  }
  function editEntry(id){ var e=S.entriesByDay[S.curDay].find(function(x){return x.id===id;}); S.editId=id; S.sel=e.k; S.mins=e.mins; document.getElementById('durInput').value=String(e.mins); renderBuilder(); }
  function delEntry(id){ S.entriesByDay[S.curDay]=S.entriesByDay[S.curDay].filter(function(x){return x.id!==id;}); if(S.editId===id){S.editId=null;S.sel=null;} renderBuilder(); }

  function saveDay(){
    var d=S.missed.find(function(x){return x.id===S.curDay;});
    d.done=true;
    document.getElementById('builder').classList.remove('on');
    var toast=document.getElementById('toast');
    document.getElementById('toastSub').textContent=d.label+' đã được ghi lại.';
    toast.classList.add('on'); setTimeout(function(){toast.classList.remove('on');},2400);
    renderHome();
    setTimeout(function(){
      if(pendingCount()>0 && remainingQuota()>0){ openDayPicker(); }
      else { document.getElementById('scrim').classList.remove('on'); }
    }, 480);
  }

  function dismissChip(){ document.getElementById('chip').classList.add('hide'); }
  function closeSheets(){ document.getElementById('scrim').classList.remove('on'); document.getElementById('dayPicker').classList.remove('on'); document.getElementById('builder').classList.remove('on'); }

  loadScenario('A');
</script>
</body>
</html>
