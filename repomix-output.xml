  .addbtn{width:100%; margin-top:14px; border:1px solid var(--primary); background:#fff; color:var(--primary); border-radius:12px; padding:12px; font-size:14px; font-weight:600; cursor:pointer;}
  .addbtn:disabled{opacity:.4; cursor:not-allowed;}

  .entry{display:flex; align-items:center; gap:10px; border:1px solid var(--line); border-radius:10px; padding:10px 12px; margin-bottom:8px;}
