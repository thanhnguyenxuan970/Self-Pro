    rotate:[[0,0],[0.55,-2],[0.66,1],[1,0]],
    translateY:[[0,0],[0.66,-3],[1,0]]}},
};

/* ==== interpolation y hệt app: lerp tuyến tính per-channel ==== */
function chVal(ch,t){
  if(t<=ch[0][0])return ch[0][1];
  if(t>=ch[ch.length-1][0])return ch[ch.length-1][1];
  for(let i=1;i<ch.length;i++){if(t<=ch[i][0]){
    const [t0,v0]=ch[i-1],[t1,v1]=ch[i];
    return v0+(v1-v0)*((t-t0)/(t1-t0));}}
  return ch[ch.length-1][1];
}
function playRankAnim(el,anim){
  const offs=[...new Set(Object.values(anim.channels).flat().map(k=>k[0]))].sort((x,y)=>x-y);
  if(offs[0]!==0)offs.unshift(0); if(offs[offs.length-1]!==1)offs.push(1);
  const frames=offs.map(t=>{
    const c=anim.channels,parts=[];
    parts.push(`translate(${c.translateX?chVal(c.translateX,t):0}px, ${c.translateY?chVal(c.translateY,t):0}px)`);
    parts.push(`rotate(${c.rotate?chVal(c.rotate,t):0}deg)`);
    const sx=c.scaleX?chVal(c.scaleX,t):(c.scale?chVal(c.scale,t):1);
    const sy=c.scaleY?chVal(c.scaleY,t):(c.scale?chVal(c.scale,t):1);
    parts.push(`scale(${sx}, ${sy})`);
    if(c.skewX)parts.push(`skewX(${chVal(c.skewX,t)}deg)`);
    /* app dùng RN p.interpolate + Easing.linear → nội suy TUYẾN TÍNH thuần.
       ease-in-out lệch tới 1.09px/0.73° (đo tại t=0.38 mock A) → phải linear. */
    return {offset:t,transform:parts.join(' '),easing:'linear'};
  });
  el.animate(frames,{duration:anim.duration,iterations:Infinity});
}

