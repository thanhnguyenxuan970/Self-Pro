  /* ============ HOME — PROGRESS ============ */
  .prog-card{margin-top:12px}
  .prog-top{display:flex;justify-content:space-between;font-size:13px;font-weight:700;color:var(--ink)}
  .prog-top .pts{font-size:14px}
  .prog-top .pts b{font-size:16px;font-weight:800;color:var(--primary)}
  .bar{height:10px;background:var(--surface-2);border-radius:var(--r-pill);margin-top:10px;overflow:hidden;
    position:relative}
  .bar > i{display:block;height:100%;background:linear-gradient(90deg,var(--primary),var(--sage-300));
    border-radius:var(--r-pill);transition:width .4s ease}
  .prog-cap{font-size:11.5px;color:var(--muted);margin-top:8px}

  /* ============ CATEGORY CHIPS ============ */
  .chips{display:flex;gap:7px;overflow-x:auto;padding:2px 2px 4px;margin:0 -2px}
  .chips::-webkit-scrollbar{height:0}
  .chip{flex:0 0 auto;font-size:12.5px;font-weight:600;padding:8px 13px;
    border-radius:var(--r-pill);background:var(--surface);color:var(--muted);
    border:1px solid var(--line-2);cursor:pointer;white-space:nowrap;
    transition:all .15s;user-select:none}
  .chip:hover:not(.on){background:var(--surface-2)}
  .chip:active{transform:scale(.96)}
  .chip.on{background:var(--primary-soft);color:var(--primary-ink);border-color:var(--primary-soft);font-weight:700}

  /* ============ TASK LIST ============ */
  .tl{padding:6px 15px}
  .task{display:flex;align-items:center;gap:13px;padding:14px 0;
    border-bottom:1px solid var(--line)}
  .task:last-child{border-bottom:none}
  .check{width:26px;height:26px;border-radius:50%;border:2px solid var(--line-2);
    flex:0 0 auto;cursor:pointer;display:flex;align-items:center;justify-content:center;
    background:var(--surface);transition:.18s;color:transparent;font-size:13px;font-weight:800}
  .check:hover{border-color:var(--primary)}
  .check:active{transform:scale(.92)}
  .check.done{background:var(--primary);border-color:var(--primary);color:#fff;
    box-shadow:0 4px 10px rgba(46,156,106,.35)}
  .check.bad{background:var(--danger);border-color:var(--danger);color:#fff;cursor:default}
  .t-body{flex:1;min-width:0}
  .t-name{font-size:14.5px;font-weight:600;color:var(--ink)}
  .task.done .t-name{color:var(--muted);text-decoration:line-through;text-decoration-color:var(--faint)}
  .t-meta{font-size:11.5px;color:var(--muted);margin-top:3px;display:flex;gap:9px;align-items:center}
  .t-meta .dot{width:3px;height:3px;background:var(--faint);border-radius:50%}
  .t-pts{font-size:13px;font-weight:800;flex:0 0 auto;display:flex;align-items:center;gap:3px}
  .t-pts.pos{color:var(--primary)}.t-pts.neg{color:var(--danger)}
  .t-pts.idle{color:var(--faint)}

  /* ---- empty state ---- */
  .empty{padding:36px 12px;text-align:center}
  .empty .em{font-size:42px;margin-bottom:8px;opacity:.6}
  .empty .et{font-size:14px;font-weight:700;color:var(--ink-2)}
  .empty .ed{font-size:12px;color:var(--muted);margin-top:4px}

  /* ============ BOTTOM TABBAR ============ */
  .tabbar{position:absolute;bottom:0;left:0;right:0;height:86px;background:var(--surface);
    border-top:1px solid var(--line);display:flex;align-items:flex-start;
    padding:9px 6px 0;z-index:50;box-shadow:0 -8px 24px rgba(0,0,0,.04)}
  .tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;
    cursor:pointer;color:var(--faint);font-size:10px;font-weight:700;padding:4px 0;
    transition:.15s;user-select:none}
  .tab svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.9;
    stroke-linecap:round;stroke-linejoin:round;transition:.18s}
  .tab:hover{color:var(--ink-2)}
  .tab.on{color:var(--primary)}
  .tab.on svg{stroke-width:2.3}
  .fab{flex:0 0 auto;width:58px;height:58px;border-radius:50%;background:var(--primary);
    color:#fff;display:flex;align-items:center;justify-content:center;
    margin-top:-18px;box-shadow:var(--sh-fab);cursor:pointer;border:none;transition:.15s}
  .fab:hover{background:var(--primary-hover);transform:translateY(-2px)}
  .fab:active{transform:scale(.95)}
  .fab svg{width:28px;height:28px;stroke:#fff;stroke-width:2.6;fill:none;stroke-linecap:round}

  /* ============ MODAL / SHEET ============ */
  .overlay{position:absolute;inset:0;background:rgba(0,0,0,.5);z-index:70;
    display:none;align-items:flex-end;backdrop-filter:blur(2px)}
  .overlay.show{display:flex;animation:overlay-in .2s ease}
  @keyframes overlay-in{from{opacity:0}to{opacity:1}}
  .sheet{background:var(--surface);width:100%;border-radius:var(--r-2xl) var(--r-2xl) 0 0;
    padding:12px 22px 26px;max-height:92%;overflow-y:auto;box-shadow:0 -20px 60px rgba(0,0,0,.25);
    animation:sheet-in .28s cubic-bezier(.2,.8,.2,1)}
  @keyframes sheet-in{from{transform:translateY(100%)}to{transform:none}}
  .handle{width:40px;height:4px;background:var(--line-2);border-radius:4px;margin:4px auto 16px}
  .sheet h3{font-size:19px;font-weight:800;margin-bottom:14px;letter-spacing:-.3px}
  .seg{display:flex;background:var(--surface-2);border-radius:var(--r-md);padding:3px;margin-bottom:14px}
  .seg button{flex:1;border:none;background:none;font-family:var(--font);
    font-size:13px;font-weight:700;padding:10px;border-radius:var(--r-sm);
    color:var(--muted);cursor:pointer;transition:.15s}
  .seg button.on{background:var(--surface);color:var(--ink);box-shadow:var(--sh-1)}
  .seg button.on.bad{color:var(--danger)}
  .field-label{font-size:11.5px;font-weight:700;color:var(--muted);
    text-transform:uppercase;letter-spacing:.5px;margin:14px 2px 7px}
  .input{width:100%;border:1.5px solid var(--line-2);border-radius:var(--r-md);padding:13px;
    font-family:var(--font);font-size:14px;background:var(--surface-2);color:var(--ink);
    transition:.18s}
  .input:focus{outline:none;border-color:var(--primary);background:var(--surface);
    box-shadow:0 0 0 4px var(--primary-soft)}
  .input.err{border-color:var(--danger);box-shadow:0 0 0 4px var(--danger-soft)}
  .err-msg{font-size:11.5px;color:var(--danger);margin-top:5px;display:none;font-weight:600}
  .err-msg.show{display:block}
  .stepper{display:flex;align-items:center;justify-content:space-between;
    border:1.5px solid var(--line-2);border-radius:var(--r-md);padding:6px 10px;background:var(--surface)}
  .stepper button{width:36px;height:36px;border-radius:var(--r-sm);border:none;
    background:var(--surface-2);font-size:20px;cursor:pointer;color:var(--ink);font-weight:700;transition:.15s}
  .stepper button:hover{background:var(--surface-3)}
  .stepper button:active{transform:scale(.92)}
  .stepper .val{font-size:15px;font-weight:800;color:var(--ink)}
  .preview{margin-top:14px;background:var(--primary-soft);border-radius:var(--r-md);
    padding:13px;font-size:14px;font-weight:700;color:var(--primary-ink);text-align:center}
  .preview.bad{background:var(--danger-soft);color:var(--danger)}
  .btn-primary{width:100%;margin-top:16px;border:none;background:var(--primary);
    color:#fff;font-family:var(--font);font-size:15px;font-weight:700;
    padding:15px;border-radius:var(--r-md);cursor:pointer;transition:.15s;
    box-shadow:0 4px 14px rgba(46,156,106,.32)}
  .btn-primary:hover{background:var(--primary-hover);transform:translateY(-1px);
    box-shadow:0 8px 20px rgba(46,156,106,.42)}
  .btn-primary:active{transform:scale(.98)}
  .btn-primary.bad{background:var(--danger);box-shadow:0 4px 14px rgba(215,64,69,.32)}
  .btn-primary.bad:hover{background:#B83438}
  .btn-primary:disabled{background:var(--surface-3);color:var(--faint);box-shadow:none;
    cursor:not-allowed;transform:none}

  /* ============ ANALYTICS ============ */
  .segbar{display:flex;background:var(--surface-2);border-radius:var(--r-md);padding:3px;margin-bottom:14px}
  .segbar button{flex:1;border:none;background:none;font-family:var(--font);font-size:12px;
    font-weight:700;padding:9px 0;border-radius:var(--r-sm);color:var(--muted);cursor:pointer;transition:.15s}
  .segbar button.on{background:var(--surface);color:var(--ink);box-shadow:var(--sh-1)}
  .chart{display:flex;align-items:flex-end;gap:6px;height:148px;padding:6px 2px 0}
  .chart .col{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%}
  .chart .col .fill{width:100%;background:var(--primary-soft);border-radius:var(--r-xs) var(--r-xs) 0 0;
    display:flex;align-items:flex-end;justify-content:center;position:relative;overflow:hidden}
  .chart .col .fill > i{width:100%;background:linear-gradient(180deg,var(--primary) 0%,var(--sage-400) 100%);
    border-radius:var(--r-xs) var(--r-xs) 0 0;transition:height .5s cubic-bezier(.2,.8,.2,1)}
  .chart .col .xl{font-size:9.5px;color:var(--muted);font-weight:600}
  /* skeleton */
  .chart.skeleton .col .fill > i{
    background:linear-gradient(90deg,var(--surface-2) 0%,var(--surface-3) 50%,var(--surface-2) 100%);
    background-size:200% 100%;animation:shimmer 1.4s linear infinite}
  @keyframes shimmer{from{background-position:200% 0}to{background-position:-200% 0}}
  .stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:6px}
  .stat{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-md);
    padding:14px;box-shadow:var(--sh-1)}
  .stat .v{font-size:22px;font-weight:800;letter-spacing:-.5px;color:var(--ink)}
  .stat .l{font-size:11px;color:var(--muted);font-weight:700;margin-top:3px}
  .stat.sk .v{background:var(--surface-2);color:transparent;border-radius:6px;
    width:60%;height:22px;animation:shimmer 1.4s linear infinite;
    background:linear-gradient(90deg,var(--surface-2) 0%,var(--surface-3) 50%,var(--surface-2) 100%);
    background-size:200% 100%}
  .stat.sk .l{background:var(--surface-2);color:transparent;border-radius:4px;
    height:11px;width:80%;margin-top:6px}
  .catrow{display:flex;align-items:center;gap:11px;margin-top:11px;font-size:13px}
  .catrow .nm{width:90px;flex:0 0 auto;font-weight:600;color:var(--ink-2)}
  .catrow .tk{flex:1;height:10px;background:var(--surface-2);border-radius:var(--r-pill);overflow:hidden}
  .catrow .tk > i{display:block;height:100%;background:linear-gradient(90deg,var(--primary),var(--sage-300));
    border-radius:var(--r-pill)}
  .catrow .pc{width:38px;text-align:right;color:var(--muted);font-weight:700;font-size:11.5px}

  /* ============ REWARDS ============ */
  .fund{background:linear-gradient(135deg,#15402E 0%,#1E6646 100%);color:#fff;
    border-radius:var(--r-xl);padding:20px;box-shadow:var(--sh-hero);position:relative;overflow:hidden}
  [data-theme="dark"] .fund{background:linear-gradient(135deg,#15402E 0%,#2E9C6A 100%)}
  .fund::after{content:"";position:absolute;left:-40px;bottom:-40px;width:200px;height:200px;
    background:radial-gradient(circle,rgba(217,149,43,.22) 0%,transparent 70%);pointer-events:none}
  .fund .fl{font-size:12px;opacity:.85;font-weight:700;letter-spacing:.3px}
  .fund .fv{font-size:36px;font-weight:800;letter-spacing:-1px;margin-top:6px;line-height:1}
  .fund .fc{font-size:11.5px;opacity:.75;margin-top:6px}
  .tier{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}
  .tier:last-child{border-bottom:none}
  .tier .badge{width:38px;height:38px;border-radius:var(--r-sm);flex:0 0 auto;
    display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:800}
  .tier .badge.crossed{background:var(--star-soft);color:var(--star)}
  .tier .badge.locked{background:var(--surface-2);color:var(--faint)}
  .tier .ti{flex:1}
  .tier .ti .a{font-size:14px;font-weight:700;color:var(--ink)}
  .tier .ti .b{font-size:11.5px;color:var(--muted);margin-top:2px}
  .tier .st{font-size:11px;font-weight:800;padding:4px 10px;border-radius:var(--r-pill);
    text-transform:uppercase;letter-spacing:.4px}
  .tier .st.crossed{background:var(--primary-soft);color:var(--primary-ink)}
  .tier .st.locked{background:var(--surface-2);color:var(--faint)}
  .ledger{display:flex;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}
  .ledger:last-child{border-bottom:none}
  .ldot{width:34px;height:34px;border-radius:var(--r-sm);flex:0 0 auto;display:flex;
    align-items:center;justify-content:center;font-size:15px}
  .ldot.in{background:var(--primary-soft);color:var(--primary-ink)}
  .ldot.out{background:var(--surface-2);color:var(--ink-2)}
  .ledger .li{flex:1;min-width:0}
  .ledger .li .a{font-size:14px;font-weight:600;color:var(--ink)}
  .ledger .li .b{font-size:11.5px;color:var(--muted);margin-top:2px}
  .ledger .amt{font-size:13.5px;font-weight:800;text-align:right;flex:0 0 auto}
  .ledger .amt.in{color:var(--primary)}.ledger .amt.out{color:var(--ink)}
  .ledger .amt small{display:block;font-size:10px;color:var(--faint);font-weight:600;margin-top:2px}

  /* ============ RANK ============ */
  .rankhero{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-xl);
    padding:22px;text-align:center;box-shadow:var(--sh-1);position:relative;overflow:hidden}
  .rankhero::before{content:"";position:absolute;inset:0;
    background:radial-gradient(ellipse at top,var(--primary-soft) 0%,transparent 60%);
    opacity:.6;pointer-events:none}
  .rankhero > *{position:relative}
  .rankhero .em{font-size:54px;filter:drop-shadow(0 4px 8px rgba(0,0,0,.15))}
  .rankhero .nm{font-size:25px;font-weight:800;letter-spacing:-.5px;margin-top:6px;color:var(--ink)}
  .rankhero .en{font-size:12.5px;color:var(--muted);margin-top:2px;font-style:italic}
  .rankhero .wk{font-size:13px;font-weight:800;margin-top:12px;
    background:var(--star-soft);color:var(--star);display:inline-block;
    padding:6px 14px;border-radius:var(--r-pill)}
  .rankhero .nextcap{font-size:12px;color:var(--muted);margin-top:13px;font-weight:600}
  .reset-chip{display:flex;align-items:center;justify-content:center;gap:7px;
    font-size:12px;font-weight:700;color:var(--ink-2);background:var(--surface-2);
    border-radius:var(--r-md);padding:11px;margin-top:12px}
  .rk{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}
  .rk:last-child{border-bottom:none}
  .rk.cur{background:var(--primary-soft);margin:0 -8px;padding:12px 14px;
    border-radius:var(--r-md);border-bottom:none}
  .rk .em{font-size:24px;width:32px;text-align:center;flex:0 0 auto}
  .rk .ri{flex:1}
  .rk .ri .a{font-size:14px;font-weight:800;color:var(--ink)}
  .rk.cur .ri .a{color:var(--primary-ink)}
  .rk .ri .b{font-size:11.5px;color:var(--muted);margin-top:2px}
  .rk .thr{font-size:11.5px;font-weight:800;color:var(--muted)}
  .rk.cur .thr{color:var(--primary-ink)}
  .rk.debt .ri .a{color:var(--danger)}
  .philo{background:linear-gradient(135deg,var(--ink) 0%,var(--ink-2) 100%);color:#fff;
    border-radius:var(--r-lg);padding:18px;margin-top:8px;box-shadow:var(--sh-1)}
  [data-theme="dark"] .philo{background:linear-gradient(135deg,#0A100D 0%,#1B231F 100%);
    border:1px solid var(--line)}
  .philo .pq{font-size:14px;line-height:1.55;font-weight:600}
  .philo .pa{font-size:11.5px;opacity:.65;margin-top:8px;font-weight:600}

  /* ============ PROFILE ============ */
  .prof-head{text-align:center;padding:14px 0 6px}
  .prof-head .pa{width:80px;height:80px;border-radius:50%;background:var(--primary-soft);
    color:var(--primary-ink);font-size:32px;font-weight:800;display:flex;align-items:center;
    justify-content:center;margin:0 auto;border:1px solid var(--line);
    box-shadow:0 8px 20px rgba(46,156,106,.18)}
  .prof-head .pn{font-size:20px;font-weight:800;margin-top:10px;letter-spacing:-.3px}
  .prof-head .pj{font-size:12.5px;color:var(--muted);margin-top:3px}
  .life{display:flex;background:var(--surface);border:1px solid var(--line);
    border-radius:var(--r-md);margin-top:14px;overflow:hidden;box-shadow:var(--sh-1)}
  .life > div{flex:1;text-align:center;padding:14px 6px;border-right:1px solid var(--line)}
  .life > div:last-child{border-right:none}
  .life .v{font-size:17px;font-weight:800;color:var(--ink)}
  .life .l{font-size:10px;color:var(--muted);font-weight:700;margin-top:3px;
    text-transform:uppercase;letter-spacing:.4px}
  .set{display:flex;align-items:center;gap:13px;padding:15px 0;border-bottom:1px solid var(--line);
    cursor:pointer;transition:.12s}
  .set:hover{background:var(--surface-2);margin:0 -10px;padding:15px 10px;border-radius:var(--r-sm)}
  .set:last-child{border-bottom:none}
  .set .si{font-size:18px;width:26px;text-align:center}
  .set .sl{flex:1;font-size:14px;font-weight:600;color:var(--ink)}
  .set .sv{font-size:12.5px;color:var(--muted);font-weight:700}
  .set .chev{color:var(--faint);font-size:18px}
  .set.danger .sl{color:var(--danger)}

  /* component states gallery */
  .states-card{padding:14px 15px}
  .states-card .st-grp{margin-top:10px}
  .states-card .st-grp:first-child{margin-top:0}
  .st-lab{font-size:10.5px;font-weight:700;color:var(--muted);
    text-transform:uppercase;letter-spacing:.6px;margin-bottom:7px}
  .st-row{display:flex;gap:7px;flex-wrap:wrap}
  .pill{font-size:11.5px;padding:6px 11px;border-radius:var(--r-pill);
    border:1px solid var(--line-2);font-weight:700;background:var(--surface)}
  .pill.default{color:var(--ink-2)}
  .pill.hover{background:var(--surface-2);color:var(--ink)}
  .pill.pressed{background:var(--primary);color:#fff;border-color:var(--primary)}
  .pill.disabled{background:var(--surface-2);color:var(--faint);border-color:var(--line)}
  .pill.focus{box-shadow:0 0 0 3px var(--primary-soft);border-color:var(--primary)}
  .pill.error{background:var(--danger-soft);color:var(--danger);border-color:var(--danger)}

  .ver{text-align:center;font-size:11px;color:var(--faint);margin-top:18px;font-weight:600}
  .hint{font-size:12px;color:var(--muted);margin-top:14px;text-align:center;
    max-width:380px;line-height:1.5}
</style>
</head>
<body>

<div class="doc-head">
  <h1>Habit Tracker +1% — Hi-Fi Prototype</h1>
  <p>Sage Green design system · Light + Dark · component states đầy đủ</p>
  <div class="doc-tags">
    <span class="doc-tag">Hi-Fi v0.2</span>
    <span class="doc-tag">Mobile (iOS/Android)</span>
    <span class="doc-tag">Light · Dark</span>
    <span class="doc-tag">VI / EN</span>
    <span class="doc-tag">6 màn hình</span>
  </div>
</div>

<div class="phone">
  <div class="notch"></div>

  <!-- status bar -->
  <div class="statusbar">
    <span>9:41</span>
    <span class="glyphs">
      <svg width="16" height="11" viewBox="0 0 16 11"><path fill="currentColor" d="M0 9h2v2H0zM3 7h2v4H3zM6 5h2v6H6zM9 3h2v8H9zM12 1h2v10h-2z"/></svg>
      <svg width="14" height="10" viewBox="0 0 14 10" fill="currentColor"><path d="M7 0a9 9 0 0 1 6.4 2.6l-1 1A7.6 7.6 0 0 0 7 1.4 7.6 7.6 0 0 0 1.6 3.6l-1-1A9 9 0 0 1 7 0zm0 3a6 6 0 0 1 4.2 1.7l-1 1A4.6 4.6 0 0 0 7 4.4 4.6 4.6 0 0 0 3.8 5.7l-1-1A6 6 0 0 1 7 3zm0 3a3 3 0 0 1 2.1.9l-1 1A1.6 1.6 0 0 0 7 7.4a1.6 1.6 0 0 0-1.1.5l-1-1A3 3 0 0 1 7 6zm0 3a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/></svg>
      <svg width="24" height="11" viewBox="0 0 24 11"><rect x="0" y="0" width="22" height="11" rx="3" stroke="currentColor" fill="none" opacity=".5"/><rect x="2" y="2" width="16" height="7" rx="1.5" fill="currentColor"/><rect x="23" y="3.5" width="1" height="4" fill="currentColor" opacity=".5"/></svg>
    </span>
  </div>

  <div class="viewport">

  <!-- ============ HOME ============ -->
  <section class="screen active" id="s-home">
    <div class="topbar">
      <div class="avatar" onclick="go('profile')">J</div>
      <div class="greet">
        <div class="hi" data-vi="Chào, James" data-en="Hi, James">Chào, James</div>
        <div class="date" data-vi="Thứ Hai, 25 tháng 5" data-en="Monday, May 25">Thứ Hai, 25 tháng 5</div>
      </div>
