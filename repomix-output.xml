};

// evolving trophy stages: sprout -> sapling -> tree -> forest
const EVO = {
1:`<svg viewBox="0 0 100 100"><path d="M50 82V52" stroke="#2f9d5c" stroke-width="5" stroke-linecap="round"/><path d="M50 58c-10 0-16-6-16-14 8 0 16 4 16 14z" fill="#3FB56E"/><path d="M50 52c8 0 14-5 14-12-7 0-14 3-14 12z" fill="#5fd48c"/></svg>`,
2:`<svg viewBox="0 0 100 100"><path d="M50 84V44" stroke="#2f9d5c" stroke-width="6" stroke-linecap="round"/><path d="M50 62c-13 0-20-7-20-17 10 0 20 5 20 17z" fill="#3FB56E"/><path d="M50 52c11 0 18-6 18-15-9 0-18 4-18 15z" fill="#5fd48c"/><circle cx="50" cy="40" r="10" fill="#3FB56E"/></svg>`,
3:`<svg viewBox="0 0 100 100"><path d="M50 86V50" stroke="#6b3d12" stroke-width="7" stroke-linecap="round"/><circle cx="50" cy="40" r="20" fill="#3FB56E"/><circle cx="34" cy="48" r="13" fill="#2f9d5c"/><circle cx="66" cy="48" r="13" fill="#5fd48c"/><circle cx="50" cy="30" r="12" fill="#5fd48c"/></svg>`,
4:`<svg viewBox="0 0 100 100"><path d="M30 86V58M50 88V44M72 86V60" stroke="#6b3d12" stroke-width="6" stroke-linecap="round"/><circle cx="50" cy="34" r="18" fill="#3FB56E"/><circle cx="30" cy="50" r="13" fill="#2f9d5c"/><circle cx="72" cy="52" r="12" fill="#5fd48c"/><circle cx="50" cy="20" r="10" fill="#5fd48c"/><circle cx="16" cy="60" r="8" fill="#3FB56E"/><circle cx="86" cy="62" r="8" fill="#3FB56E"/></svg>`
};

const R = {common:'THƯỜNG · 41%',rare:'HIẾM · 12%',epic:'CỰC HIẾM · 4%',myth:'HUYỀN THOẠI · 0.9%'};

const FLEX=[
 {k:'anchor',r:'rare',vn:'Lowkey Locked In',en:'Fewest missed days, not longest streak',
  desc:'Ít ngày bỏ lỡ nhất tháng — thưởng cho việc xuất hiện đều, kể cả chưa hoàn hảo.',
  why:'<b>Why it wows:</b> rewards the un-glamorous behavior streaks punish. Rarity tag makes "reliable" feel elite.'},
 {k:'constellation',r:'epic',vn:'Bộ Sưu Tập Đủ Cả',en:'Full Deck — breadth',
  desc:'Duy trì 5+ loại thói quen cùng lúc. Không cày một cái — sống cả app.',
  why:'<b>Why it wows:</b> pushes users into more of the product; epic-rarity flex for power users.'},
];
const SECRET=[
 {k:'clock',vn:'Cinderella',en:'Log at 00:00 sharp',tap:'??? tap',
  desc:'Log đúng nửa đêm 00:00. Không ai bảo bạn — bạn tự tìm ra.',
  why:'<b>Why it wows:</b> discovery dopamine. No checklist, pure "wait, there was a secret?"'},
 {k:'bolt',vn:'Speedrun',en:'3 habits in under 3 minutes',tap:'??? tap',
  desc:'Xong 3 thói quen trong 3 phút. Tốc độ của người đã locked in.',
  why:'<b>Why it wows:</b> turns a normal session into a challenge. Screenshot bait.'},
 {k:'cake',vn:'Sinh Nhật Vẫn Cày',en:'Log on your birthday',tap:'??? tap',
  desc:'Vẫn giữ thói quen ngay cả ngày sinh nhật. Real dedication.',
  why:'<b>Why it wows:</b> feels personal — the app noticed your day. Emotional, not mechanical.'},
];
const STAKES=[
 {k:'freeze',r:'myth',vn:'Băng Bảo Hộ',en:'Streak Freeze — a real reward',
  desc:'Mở khoá = nhận 1 lượt đóng băng streak. Trophy đầu tiên ẢNH HƯỞNG tới lối chơi.',
  why:'<b>Why it wows:</b> the boldest lever — chasing this trophy = chasing survival. Heaviest build (touches streak logic), biggest payoff.'},
 {k:'lantern',r:'epic',vn:'Streak Mùa Tết',en:'Seasonal drop — gone after Tết',
  desc:'Chỉ kiếm được trong dịp Tết. Hết mùa là mất vĩnh viễn.',
  why:'<b>Why it wows:</b> real FOMO drives daily opens in the window. Cheap: date + streak you already track.'},
];

function card(d,secret){
  return `<div class="card ${secret?'secret':''}" ${secret?'onclick="this.classList.add(\'revealed\')"':''}>
    ${secret?'<span class="tap">'+d.tap+'</span><div class="q">? ? ?</div>':''}
    <div class="${secret?'hidden-body':''}">
      <div class="glow" style="background:${({anchor:'#3FB56E',constellation:'#7A5CE0',clock:'#EF5A2B',bolt:'#e6b52e',cake:'#e0559a',freeze:'#37a7c3',lantern:'#EF5A2B'})[d.k]}"></div>
      <div class="top">${E[d.k]}<div><div class="vn">${d.vn}</div><div class="en">${d.en}</div>
        ${d.r?`<span class="rarity r-${d.r}">◆ ${R[d.r]}</span>`:''}</div></div>
      <div class="desc">${d.desc}</div>
      <div class="why">${d.why}</div>
    </div></div>`;
}
document.getElementById('flex').innerHTML=FLEX.map(d=>card(d,false)).join('');
document.getElementById('secret').innerHTML=SECRET.map(d=>card(d,true)).join('');
document.getElementById('stakes').innerHTML=STAKES.map(d=>card(d,false)).join('');
document.getElementById('evo').innerHTML=
 [[1,'Mầm','Ngày 1'],[2,'Chồi','Ngày 30'],[3,'Cây','Ngày 100'],[4,'Rừng','Ngày 365']]
 .map((s,i)=>`<div class="stage">${EVO[s[0]]}<div class="lab">${s[1]}</div><div class="d">${s[2]}</div>${i<3?'<span class="arrow">→</span>':''}</div>`).join('')
 + `<div class="evo-note"><b>The Living Trophy:</b> one badge, four states — it visibly grows as the user stays. People get attached to things that grow (Tamagotchi, Snap streaks). This is the badge they'd be genuinely sad to lose.</div>`;
</script>
