      let discardedEntries = [];
      let canceledApplyEvents = [];
      let transactionRollback = null;
      try {
        const buffer = readManualEditsBuffer(projectCwd());
        transactionRollback = manualApply.rollbackTransaction({
          pageUrl,
          reason: 'manual_edit_discarded',
