await db.runAsync(
  `INSERT INTO task_types ... ON CONFLICT ... DO UPDATE SET archived = 0, ...`,
  [userId, params.name, ...]
);
const row = await db.getFirstAsync<{ id: number }>(
  'SELECT id FROM task_types WHERE user_id = ? AND name = ? AND archived = 0',
  [userId, params.name]
