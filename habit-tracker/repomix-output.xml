    ...baseGoodTask,
    currentDayPoints: 45,
    basePoints: 10,
    bonusStarsAwarded: 1,
  });
  expect(result.bonusRow!.stars_delta).toBe(2);
});

test('bonus is not awarded twice after reaching 50 points', () => {
