nul
.gstack/
.github/hooks/

# Local Codex overrides and diagnostics
AGENTS.override.md
**/AGENTS.override.md
.codex-log/
.codex/*.local.toml

# Android QA raw logcat scratch files (keep device data out of the repository)
/.audit/*.log
/.audit/**/*.log
/.audit/*.db
/.audit/**/*.db
/.audit/*.txt
/.audit/**/*.txt
/.audit/META-INF/

# Android QA captures containing local account or pre-release state
/.visual-verify/oauth-debug-after-account.*
/.visual-verify/pre-aab-emulator-5554.*
/.visual-verify/pre-auth-2abi-update.*
/.visual-verify/release-h-google-signin-dialog.*

# JVM crash dumps
hs_err_pid*.log
replay_pid*.log

# repomix context dumps (generated, not source)
repomix-output.xml
**/repomix-output.xml

# stray root-level npm install (not part of the project)
/node_modules/
/package.json
/package-lock.json

# JetBrains IDE workspace state (machine-local)
.idea/
