nul

# Local Supabase CLI credentials (may include OAuth client secrets).
/supabase/.env
.gstack/
.github/hooks/

# Local Codex overrides and diagnostics
AGENTS.override.md
**/AGENTS.override.md
.codex-log/
.codex/*.local.toml

# Local QA/audit evidence can contain account data, database exports, and
# credentials. These directories contain no tracked source files.
/.audit/
/.visual-verify/

# JVM crash dumps
hs_err_pid*.log
replay_pid*.log

# repomix context dumps (generated, not source)
repomix-output.xml
**/repomix-output.xml

# stray root-level npm install (not part of the project)
/node_modules/
/package.json
/package-lock.json

# JetBrains IDE workspace state (machine-local)
.idea/
